# Copy this file to .env. Process environment variables take precedence.
SECRET_KEY=
# Key setup and retention: docs/security/media-action-ip-privacy.md
MEDIA_ACTION_IP_HMAC_KEY=
DEBUG=true
LOCAL_INSTALL=true
PORTAL_NAME=CinemataCMS
# ADMIN_PASS=
FRONTEND_HOST=http://localhost:8000
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_NAME=mediacms
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=mediacms
DATABASE_PASSWORD=mediacms
# Optional dedicated database service started by `make test-db-up`.
# TEST_DATABASE_NAME=mediacms
# TEST_DATABASE_HOST=127.0.0.1
# TEST_DATABASE_PORT=5433
# TEST_DATABASE_USER=mediacms
# TEST_DATABASE_PASSWORD=mediacms
REDIS_LOCATION=redis://127.0.0.1:6379/1
USE_X_ACCEL_REDIRECT=false
MFA_REQUIRED_ROLES=superuser
# UPLOAD_HOST=http://localhost:8000
VITE_DEV_MODE=true
# Observe CSP violations before enabling blocking in a validated deployment.
CSP_REPORT_ONLY=true
# Optional operator-owned report collector; none is bundled with the CMS.
# CSP_REPORT_URI=https://reports.example.org/csp
# Extra sources extend the built-in policy; see docs/security/Implementing_CSP.md.
# CSP_IMG_SRC=https://images.example.org
# CSP_CONNECT_SRC=https://uploads.example.org
# Optional CMS analytics; Umami configuration adds event collection and reports.
ANALYTICS_ENABLED=false
# ANALYTICS_URL=https://analytics.example.org
# ANALYTICS_WEBSITE_ID=
# ANALYTICS_API_KEY=
