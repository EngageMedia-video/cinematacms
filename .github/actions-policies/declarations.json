{
  "name": "Allow pull_request_target for declaration workflows",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "include": [
        ".github/workflows/ai-declaration.yml",
        ".github/workflows/analytics-declaration.yml"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": ["pull_request_target"]
      }
    }
  ]
}
