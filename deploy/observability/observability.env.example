# Copy to a root-readable path and pass it with --env.
APP_METRICS_PORT="8001"
APP_LOG_PATH="/home/cinemata/cinematacms/logs/app.json.log"
APP_SERVICE_LOG_DIR="/home/cinemata/cinematacms/logs"
# Public HTTPS health endpoint used for independent availability and TLS checks.
EXTERNAL_HEALTH_URL="https://video.example.org/"
OBSERVABILITY_ENVIRONMENT="production"

METRICS_RETENTION="90d"
LOGS_RETENTION="30d"
TRACES_RETENTION="14d"

VICTORIAMETRICS_PORT="8428"
VICTORIALOGS_PORT="9428"
VICTORIATRACES_PORT="10428"
ALERTMANAGER_PORT="9093"
VMALERT_PORT="8880"
GRAFANA_URL="http://127.0.0.1:3000"
# Required when anonymous Viewer access is disabled (recommended in production).
GRAFANA_API_TOKEN=""
# Internal POST endpoint exposed by the application. Keep its bearer token in
# the root-readable environment file; Grafana stores it as secureJsonData.
INCIDENT_REFERENCE_LOOKUP_URL="http://127.0.0.1:8001/internal/observability/references"
INCIDENT_REFERENCE_LOOKUP_ORIGIN="http://127.0.0.1:8001"
INCIDENT_REFERENCE_LOOKUP_TOKEN="change-me"

POSTGRES_DSN="postgresql://cinematacms_monitor:change-me@127.0.0.1:5432/mediacms?sslmode=disable"
POSTGRES_MONITOR_PASSWORD="change-me"
REDIS_URL="redis://127.0.0.1:6379/1"

# Leave SMTP_TO empty for a local/staging install with a null receiver.
SMTP_SMARTHOST="smtp.example.org:587"
SMTP_FROM="alerts@example.org"
SMTP_USER="alerts@example.org"
SMTP_PASSWORD="change-me"
SMTP_TO="ops@example.org"
