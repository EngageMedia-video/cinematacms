${APP_SERVICE_LOG_DIR}/*.log ${APP_SERVICE_LOG_DIR}/errorlog.txt ${UNCOVERED_APP_LOG} {
  daily
  maxsize 100M
  rotate 14
  missingok
  notifempty
  # the Collector's default fingerprint covers the first 1000 bytes, so a shorter log and its .1 copy can be read twice
  minsize 1k
  compress
  delaycompress
  # the Collector reads the .1 name, so a host-wide dateext must not rename it
  nodateext
  # celery, uwsgi and the Django FileHandler keep the file open; truncating in place avoids a restart
  # and leaves the live file's owner, group and mode untouched.
  copytruncate
}
