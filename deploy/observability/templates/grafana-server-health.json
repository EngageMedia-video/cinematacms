    {"type": "stat", "title": "Host uptime", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 300}]}}, "overrides": []}, "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "targets": [{"expr": "max({__name__=\"system.uptime\"})", "legendFormat": "uptime", "refId": "A"}]},
