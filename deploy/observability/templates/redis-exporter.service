[Unit]
Description=Cinemata Redis exporter
After=network-online.target redis-server.service

[Service]
User=cinematacms-redis-exporter
Group=cinematacms-redis-exporter
EnvironmentFile=/etc/cinematacms-observability/redis-exporter.env
ExecStart=/opt/cinematacms-observability/bin/redis_exporter --web.listen-address=127.0.0.1:9121
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
