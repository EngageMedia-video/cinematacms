  ],
  "panels": [
    {"type": "text", "title": "Operational definitions", "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0}, "options": {"mode": "markdown", "content": "**smtp_accepted** means the SMTP server accepted the message; it does not prove inbox delivery. **unknown** means no terminal outcome was observed. Execution state and domain outcome are separate. Staff may search privacy-safe `actor_ref`, `recipient_ref`, delivery UUID, task ID, and trace ID; raw addresses must never appear."}},
    {"type": "row", "title": "Celery overview", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Task lifecycle rate", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "targets": [{"expr": "sum by (task_family, queue, event, outcome) (rate(cinematacms_celery_tasks_total[$__rate_interval]))", "legendFormat": "{{task_family}} {{queue}} {{event}} {{outcome}}"}]},
    {"type": "timeseries", "title": "Queue depth and worker freshness", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "targets": [{"expr": "cinematacms_celery_queue_depth", "legendFormat": "depth {{queue}}"}, {"expr": "time() - cinematacms_celery_worker_heartbeat_timestamp_seconds", "legendFormat": "heartbeat age {{service_role}} {{worker_ref}}"}, {"expr": "time() - cinematacms_celery_beat_freshness_timestamp_seconds", "legendFormat": "beat age"}]},
    {"type": "row", "title": "Media pipeline", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Media outcomes and attempts", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15}, "targets": [{"expr": "sum by (operation, outcome, reason_code) (rate(cinematacms_domain_outcomes_total[$__rate_interval]))", "legendFormat": "{{operation}} {{outcome}} {{reason_code}}"}]},
    {"type": "timeseries", "title": "Transcription queue pressure", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15}, "targets": [{"expr": "cinematacms_celery_queue_depth{queue=\"whisper_tasks\"}", "legendFormat": "transcription {{queue}}"}]},
    {"type": "row", "title": "Email delivery", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Delivery outcomes", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}, "targets": [{"expr": "sum by (email_kind, outcome, reason_code) (rate(cinematacms_email_deliveries_total[$__rate_interval]))", "legendFormat": "{{email_kind}} {{outcome}} {{reason_code}}"}]},
    {"type": "row", "title": "Web and API", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Request and failure rate", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 33}, "targets": [{"expr": "sum by (route_group, status_code) (rate(cinematacms_http_requests_total[$__rate_interval]))", "legendFormat": "{{route_group}} {{status_code}}"}, {"expr": "sum(rate(cinematacms_http_requests_total{status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(cinematacms_http_requests_total[$__rate_interval])), 0.001) or vector(0)", "legendFormat": "5xx ratio"}]},
    {"type": "timeseries", "title": "Request latency percentiles", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 33}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route_group) (rate(cinematacms_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{route_group}}"}, {"expr": "histogram_quantile(0.99, sum by (le, route_group) (rate(cinematacms_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99 {{route_group}}"}]},
    {"type": "row", "title": "Scheduled jobs", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 41}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Last successful run age", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 42}, "targets": [{"expr": "time() - cinematacms_scheduled_job_last_success_timestamp_seconds", "legendFormat": "{{job}}"}]},
    {"type": "row", "title": "Telemetry health", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 50}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Collector queue and export failures", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 51}, "targets": [{"expr": "otelcol_exporter_queue_size", "legendFormat": "queue {{exporter}}"}, {"expr": "(sum(rate(otelcol_exporter_send_failed_metric_points[$__rate_interval])) or vector(0)) + (sum(rate(otelcol_exporter_send_failed_log_records[$__rate_interval])) or vector(0)) + (sum(rate(otelcol_exporter_send_failed_spans[$__rate_interval])) or vector(0))", "legendFormat": "export failures"}, {"expr": "sum by (data_type) (rate({__name__=~\"otelcol_receiver_(failed|refused)_.+\"}[$__rate_interval]))", "legendFormat": "receiver loss {{data_type}}"}, {"expr": "sum(rate(otelcol_scraper_errored_metric_points[$__rate_interval])) or vector(0)", "legendFormat": "scrape errors"}]},
    {"type": "timeseries", "title": "Storage and scrape health", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 51}, "targets": [{"expr": "up", "legendFormat": "{{job}}"}]},
    {"type": "row", "title": "External services", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 59}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "PostgreSQL connections", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 6, "x": 0, "y": 60}, "targets": [{"expr": "sum by (datname) (pg_stat_activity_count)", "legendFormat": "{{datname}}"}]},
    {"type": "timeseries", "title": "Redis memory", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 6, "x": 6, "y": 60}, "targets": [{"expr": "redis_memory_used_bytes", "legendFormat": "used"}, {"expr": "redis_memory_max_bytes", "legendFormat": "maximum"}]},
    {"type": "timeseries", "title": "Nginx requests", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 6, "x": 12, "y": 60}, "targets": [{"expr": "rate(nginx_http_requests_total[$__rate_interval])", "legendFormat": "requests/s"}]},
    {"type": "timeseries", "title": "Celery exporter queues", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 6, "x": 18, "y": 60}, "targets": [{"expr": "celery_queue_length", "legendFormat": "{{queue_name}}"}]},
    {"type": "row", "title": "Application diagnostics", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 69}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Celery active work and latency", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 70}, "targets": [{"expr": "sum by (worker) (celery_worker_tasks_active)", "legendFormat": "active {{worker}}"}, {"expr": "histogram_quantile(0.95, sum by (le, task_family, queue) (rate(cinematacms_celery_task_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{task_family}} {{queue}}"}]},
    {"type": "timeseries", "title": "Media profile and workload", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 70}, "targets": [{"expr": "sum by (resolution, codec, extension, outcome, reason_code) (rate(cinematacms_media_encoding_profile_total[$__rate_interval]))", "legendFormat": "{{resolution}} {{codec}} {{extension}} {{outcome}} {{reason_code}}"}, {"expr": "histogram_quantile(0.95, sum by (le, media_type) (rate(cinematacms_media_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "duration p95 {{media_type}}"}, {"expr": "histogram_quantile(0.95, sum by (le, media_type) (rate(cinematacms_media_file_size_bytes_bucket[$__rate_interval])))", "legendFormat": "size p95 {{media_type}}"}]},
    {"type": "timeseries", "title": "Email attempts and latency", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 78}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(cinematacms_email_delivery_attempts_bucket[$__rate_interval])))", "legendFormat": "attempts p95"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(cinematacms_email_delivery_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "delivery latency p95"}]},
    {"type": "timeseries", "title": "Scheduled job lifecycle", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 78}, "targets": [{"expr": "time() - cinematacms_scheduled_job_last_started_timestamp_seconds", "legendFormat": "last start {{job}}"}, {"expr": "sum by (job, outcome, reason_code) (rate(cinematacms_scheduled_job_runs_total[$__rate_interval]))", "legendFormat": "{{job}} {{outcome}} {{reason_code}}"}]},
    {"type": "timeseries", "title": "Database query latency", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 86}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, workload, context_group, operation, outcome, database) (rate(cinematacms_db_query_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{workload}} {{context_group}} {{operation}} {{outcome}} {{database}}"}]},
    {"type": "timeseries", "title": "Cache health", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 86}, "targets": [{"expr": "sum by (family, operation, result) (rate(cinematacms_cache_operations_total[$__rate_interval]))", "legendFormat": "ops {{family}} {{operation}} {{result}}"}, {"expr": "histogram_quantile(0.95, sum by (le, family, operation, result) (rate(cinematacms_cache_operation_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{family}} {{operation}} {{result}}"}, {"expr": "sum by (family, result) (cinematacms_cache_items_total)", "legendFormat": "items {{family}} {{result}}"}]},
    {"type": "timeseries", "title": "Authentication failures", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 94}, "targets": [{"expr": "sum by (surface, mechanism, reason) (rate(cinematacms_authentication_failures_total[$__rate_interval]))", "legendFormat": "{{surface}} {{mechanism}} {{reason}}"}]},
    {"type": "timeseries", "title": "Telemetry contract health", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 94}, "targets": [{"expr": "sum by (signal, component, stage) (rate(cinematacms_telemetry_emission_failures_total[$__rate_interval]))", "legendFormat": "emission {{signal}} {{component}} {{stage}}"}, {"expr": "sum by (component, field) (rate(cinematacms_telemetry_contract_violations_total[$__rate_interval]))", "legendFormat": "contract {{component}} {{field}}"}]},
    {"type": "row", "title": "Host and public availability", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 102}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Host CPU and memory", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 103}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "targets": [{"expr": "1 - sum(rate({__name__=\"system.cpu.time\",state=\"idle\"}[$__rate_interval])) / clamp_min(sum(rate({__name__=\"system.cpu.time\"}[$__rate_interval])), 0.001)", "legendFormat": "CPU used"}, {"expr": "sum({__name__=\"system.memory.usage\",state=\"used\"}) / clamp_min(sum({__name__=\"system.memory.usage\"}), 1)", "legendFormat": "memory used"}]},
    {"type": "timeseries", "title": "Filesystem, endpoint, and TLS", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 103}, "targets": [{"expr": "1 - node_filesystem_avail_bytes{mountpoint=~\"/|/var|/home\"} / clamp_min(node_filesystem_size_bytes{mountpoint=~\"/|/var|/home\"}, 1)", "legendFormat": "filesystem {{mountpoint}}", "refId": "A"}, {"expr": "{__name__=\"httpcheck.status\",http.status_class=\"2xx\"}", "legendFormat": "endpoint {{http.url}}", "refId": "B"}, {"expr": "{__name__=\"httpcheck.tls.cert_remaining\"}", "legendFormat": "TLS remaining {{http.url}}", "refId": "C"}], "fieldConfig": {"defaults": {}, "overrides": [{"matcher": {"id": "byFrameRefID", "options": "A"}, "properties": [{"id": "unit", "value": "percentunit"}, {"id": "min", "value": 0}, {"id": "max", "value": 1}]}, {"matcher": {"id": "byFrameRefID", "options": "B"}, "properties": [{"id": "unit", "value": "short"}]}, {"matcher": {"id": "byFrameRefID", "options": "C"}, "properties": [{"id": "unit", "value": "s"}]}]}}
  ],
  "refresh": "30s",
  "schemaVersion": 41,
