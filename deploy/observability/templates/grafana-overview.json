    {"type": "timeseries", "title": "Host CPU and memory", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 136}, "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}, "targets": [{"expr": "1 - sum(rate({__name__=\"system.cpu.time\",state=\"idle\"}[$__rate_interval])) / clamp_min(sum(rate({__name__=\"system.cpu.time\"}[$__rate_interval])), 0.001)", "legendFormat": "CPU used"}, {"expr": "sum({__name__=\"system.memory.usage\",state=\"used\"}) / clamp_min(sum({__name__=\"system.memory.usage\"}), 1)", "legendFormat": "memory used"}]},
