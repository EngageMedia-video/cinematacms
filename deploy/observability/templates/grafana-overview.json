  ],
  "panels": [
    {"type": "text", "title": "Operational definitions", "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0}, "options": {"mode": "markdown", "content": "**smtp_accepted** means the SMTP server accepted the message; it does not prove inbox delivery. **unknown** means no terminal outcome was observed. Execution state and domain outcome are separate. **lock_held** under chunking means another worker already claimed the chunk group: an absorbed race, not a failure. A claimed event without a succeeded event is a failed merge. Staff may search privacy-safe `actor_ref`, `recipient_ref`, delivery UUID, task ID, and trace ID; raw addresses must never appear."}},
    {"type": "row", "title": "Celery overview", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Task lifecycle rate", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "targets": [{"expr": "sum by (task_family, queue, event, outcome) (rate(cinematacms_celery_tasks_total[$__rate_interval]))", "legendFormat": "{{task_family}} {{queue}} {{event}} {{outcome}}"}]},
    {"type": "timeseries", "title": "Queue depth and worker freshness", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "targets": [{"expr": "cinematacms_celery_queue_depth", "legendFormat": "depth {{queue}}"}, {"expr": "time() - max by (service_role) (cinematacms_celery_worker_heartbeat_timestamp_seconds)", "legendFormat": "heartbeat age {{service_role}}"}, {"expr": "time() - cinematacms_celery_beat_freshness_timestamp_seconds", "legendFormat": "beat age"}]},
    {"type": "row", "title": "Media pipeline", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Media outcomes and attempts", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15}, "targets": [{"expr": "sum by (operation, outcome, reason_code) (rate(cinematacms_domain_outcomes_total[$__rate_interval]))", "legendFormat": "{{operation}} {{outcome}} {{reason_code}}"}]},
    {"type": "timeseries", "title": "Transcription queue pressure", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15}, "targets": [{"expr": "cinematacms_celery_queue_depth{queue=\"whisper_tasks\"}", "legendFormat": "transcription {{queue}}"}]},
    {"type": "stat", "title": "Chunk finalisation lost races", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 6, "x": 0, "y": 23}, "targets": [{"expr": "sum(increase(cinematacms_domain_outcomes_total{operation=\"chunking\",outcome=\"skipped\",reason_code=\"lock_held\"}[$__range])) or vector(0)", "legendFormat": "lock_held"}], "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none"}},
    {"type": "bargauge", "title": "Chunk finalisation outcomes", "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"}, "gridPos": {"h": 8, "w": 6, "x": 6, "y": 23}, "targets": [{"refId": "A", "editorMode": "code", "expr": "_msg:\"cinematacms.media.pipeline\" | stats by (stage, outcome, reason_code) count() events | sort by (events desc)", "legendFormat": "{{stage}} {{outcome}} {{reason_code}}", "queryType": "stats"}], "options": {"displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 16}},
    {"type": "logs", "title": "Chunk finalisation events", "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23}, "targets": [{"refId": "A", "editorMode": "code", "expr": "_msg:\"cinematacms.media.pipeline\"", "maxLines": 200, "queryType": "instant"}], "options": {"showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"}},
    {"type": "row", "title": "FFmpeg, Bento4 and Whisper", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31}, "collapsed": false, "panels": []},
    {"type": "stat", "title": "Tool outcomes in range", "description": "Domain outcomes in the selected range. FFmpeg is the encoding operation, Bento4 is the hls operation (mp4hls inside create_hls), Whisper is the transcription operation. Bento4 retried is mostly lock_held, another run already holding the media lock, and FFmpeg retries are not recorded as outcomes. Task errors counts Celery task failures from the exporter, which also include a lost worker and exceptions that no outcome records. Whisper counts a transcription request that already exists as failed.", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 16, "x": 0, "y": 32}, "targets": [{"refId": "A", "expr": "sum(increase(cinematacms_domain_outcomes_total{operation=\"encoding\",outcome=\"succeeded\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "FFmpeg succeeded"}, {"refId": "B", "expr": "sum(increase(cinematacms_domain_outcomes_total{operation=\"encoding\",outcome=\"failed\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "FFmpeg failed"}, {"refId": "C", "expr": "sum(increase(cinematacms_domain_outcomes_total{operation=\"encoding\",outcome=\"retried\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "FFmpeg retried"}, {"refId": "D", "expr": "sum(increase(celery_task_failed_total{name=\"encode_media\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "FFmpeg task errors"}, {"refId": "E", "expr": "sum(increase(cinematacms_domain_outcomes_total{operation=\"hls\",outcome=\"succeeded\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "Bento4 succeeded"}, {"refId": "F", "expr": "sum(increase(cinematacms_domain_outcomes_total{operation=\"hls\",outcome=\"failed\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "Bento4 failed"}, {"refId": "G", "expr": "sum(increase(cinematacms_domain_outcomes_total{operation=\"hls\",outcome=\"retried\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "Bento4 retried"}, {"refId": "H", "expr": "sum(increase(celery_task_failed_total{name=\"create_hls\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "Bento4 task errors"}, {"refId": "I", "expr": "sum(increase(cinematacms_domain_outcomes_total{operation=\"transcription\",outcome=\"succeeded\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "Whisper succeeded"}, {"refId": "J", "expr": "sum(increase(cinematacms_domain_outcomes_total{operation=\"transcription\",outcome=\"failed\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "Whisper failed"}, {"refId": "K", "expr": "sum(increase(cinematacms_domain_outcomes_total{operation=\"transcription\",outcome=\"retried\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "Whisper retried"}, {"refId": "L", "expr": "sum(increase(celery_task_failed_total{name=\"whisper_transcribe\"}[$__range])) or on() vector(0)", "instant": true, "legendFormat": "Whisper task errors"}], "fieldConfig": {"defaults": {"decimals": 0, "min": 0}, "overrides": [{"matcher": {"id": "byRegexp", "options": "/.*succeeded/"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}, {"matcher": {"id": "byRegexp", "options": "/.*retried/"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]}, {"matcher": {"id": "byRegexp", "options": "/.*(failed|task errors)/"}, "properties": [{"id": "color", "value": {"mode": "thresholds"}}]}, {"matcher": {"id": "byRegexp", "options": "/.*(failed|task errors)/"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}]}]}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "graphMode": "none", "textMode": "value_and_name", "orientation": "auto", "colorMode": "value", "text": {"titleSize": 14, "valueSize": 44}}},
    {"type": "stat", "title": "Tool runtime in range", "description": "p50 and p95 runtime of successful task runs in the selected range, from the celery exporter runtime histogram. Choose a range that starts after the exporter bucket change, otherwise the old 10 second buckets distort the percentile. Bento4 includes runs that returned at once because another run held the lock. A tool with no successful run in the range shows no data.", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 32}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.5, sum by (le) (increase(celery_task_runtime_bucket{name=\"encode_media\"}[$__range])))", "instant": true, "legendFormat": "FFmpeg p50"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (increase(celery_task_runtime_bucket{name=\"encode_media\"}[$__range])))", "instant": true, "legendFormat": "FFmpeg p95"}, {"refId": "C", "expr": "histogram_quantile(0.5, sum by (le) (increase(celery_task_runtime_bucket{name=\"create_hls\"}[$__range])))", "instant": true, "legendFormat": "Bento4 p50"}, {"refId": "D", "expr": "histogram_quantile(0.95, sum by (le) (increase(celery_task_runtime_bucket{name=\"create_hls\"}[$__range])))", "instant": true, "legendFormat": "Bento4 p95"}, {"refId": "E", "expr": "histogram_quantile(0.5, sum by (le) (increase(celery_task_runtime_bucket{name=\"whisper_transcribe\"}[$__range])))", "instant": true, "legendFormat": "Whisper p50"}, {"refId": "F", "expr": "histogram_quantile(0.95, sum by (le) (increase(celery_task_runtime_bucket{name=\"whisper_transcribe\"}[$__range])))", "instant": true, "legendFormat": "Whisper p95"}], "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "graphMode": "none", "textMode": "value_and_name", "orientation": "auto", "colorMode": "none"}},
    {"type": "timeseries", "title": "Tool outcomes over time", "description": "Outcomes per tool and reason_code, counted over each rate window.", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 40}, "targets": [{"refId": "A", "expr": "sum by (outcome, reason_code) (increase(cinematacms_domain_outcomes_total{operation=\"encoding\"}[$__rate_interval])) or on() vector(0)", "legendFormat": "FFmpeg {{outcome}} {{reason_code}}"}, {"refId": "B", "expr": "sum by (outcome, reason_code) (increase(cinematacms_domain_outcomes_total{operation=\"hls\"}[$__rate_interval])) or on() vector(0)", "legendFormat": "Bento4 {{outcome}} {{reason_code}}"}, {"refId": "C", "expr": "sum by (outcome, reason_code) (increase(cinematacms_domain_outcomes_total{operation=\"transcription\"}[$__rate_interval])) or on() vector(0)", "legendFormat": "Whisper {{outcome}} {{reason_code}}"}], "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "custom": {"drawStyle": "bars", "fillOpacity": 60}}, "overrides": []}},
    {"type": "logs", "title": "Recent tool failures", "description": "Failure messages from the long and Whisper worker units. The units log plain text, so the messages written by files/tasks.py and the Celery lines for a raised error or a lost worker select the lines.", "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 48}, "targets": [{"refId": "A", "editorMode": "code", "expr": "(systemd.unit:\"celery_long.service\" OR systemd.unit:\"celery_whisper.service\") AND _msg:~\"Task (encode_media|create_hls|whisper_transcribe).* raised unexpected|mp4hls (failed|timed out|produced)|Bento4 mp4hls command|Whisper (command failed|command not found|model not found)|ffmpeg error|Exception running (ffmpeg|whisper)|Unexpected error in transcription|WAV file not created|Output VTT file not created|Encoding iteration limit|No progress for|Task handler raised error|failed to get media with friendly_token|Media file not found at|Language '.*' not found in database|Exception saving subtitle\"", "maxLines": 100, "queryType": "instant"}], "options": {"showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"}},
    {"type": "row", "title": "Email delivery", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 56}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Delivery outcomes", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 57}, "targets": [{"expr": "sum by (email_kind, outcome, reason_code) (rate(cinematacms_email_deliveries_total[$__rate_interval]))", "legendFormat": "{{email_kind}} {{outcome}} {{reason_code}}"}]},
    {"type": "row", "title": "Web and API", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 65}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Request and failure rate", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 66}, "targets": [{"expr": "sum by (route_group, status_code) (rate(cinematacms_http_requests_total[$__rate_interval]))", "legendFormat": "{{route_group}} {{status_code}}"}, {"expr": "sum(rate(cinematacms_http_requests_total{status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(cinematacms_http_requests_total[$__rate_interval])), 0.001) or vector(0)", "legendFormat": "5xx ratio"}]},
    {"type": "timeseries", "title": "Request latency percentiles", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 66}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, route_group) (rate(cinematacms_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{route_group}}"}, {"expr": "histogram_quantile(0.99, sum by (le, route_group) (rate(cinematacms_http_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p99 {{route_group}}"}]},
    {"type": "row", "title": "Scheduled jobs", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 74}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Last successful run age", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 24, "x": 0, "y": 75}, "targets": [{"expr": "time() - cinematacms_scheduled_job_last_success_timestamp_seconds", "legendFormat": "{{job}}"}]},
    {"type": "row", "title": "Telemetry health", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 83}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Collector queue and export failures", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 84}, "targets": [{"expr": "otelcol_exporter_queue_size", "legendFormat": "queue {{exporter}}"}, {"expr": "(sum(rate(otelcol_exporter_send_failed_metric_points[$__rate_interval])) or vector(0)) + (sum(rate(otelcol_exporter_send_failed_log_records[$__rate_interval])) or vector(0)) + (sum(rate(otelcol_exporter_send_failed_spans[$__rate_interval])) or vector(0))", "legendFormat": "export failures"}, {"expr": "sum by (data_type) (rate({__name__=~\"otelcol_receiver_(failed|refused)_.+\"}[$__rate_interval]))", "legendFormat": "receiver loss {{data_type}}"}, {"expr": "sum(rate(otelcol_scraper_errored_metric_points[$__rate_interval])) or vector(0)", "legendFormat": "scrape errors"}]},
    {"type": "timeseries", "title": "Storage and scrape health", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 84}, "targets": [{"expr": "up", "legendFormat": "{{job}}"}]},
    {"type": "row", "title": "External services", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 92}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "PostgreSQL connections", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 6, "x": 0, "y": 93}, "targets": [{"expr": "sum by (datname) (pg_stat_activity_count)", "legendFormat": "{{datname}}"}]},
    {"type": "timeseries", "title": "Redis memory", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 6, "x": 6, "y": 93}, "targets": [{"expr": "redis_memory_used_bytes", "legendFormat": "used"}, {"expr": "redis_memory_max_bytes", "legendFormat": "maximum"}]},
    {"type": "timeseries", "title": "Nginx requests", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 6, "x": 12, "y": 93}, "targets": [{"expr": "rate(nginx_http_requests_total[$__rate_interval])", "legendFormat": "requests/s"}]},
    {"type": "timeseries", "title": "Celery exporter queues", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 6, "x": 18, "y": 93}, "targets": [{"expr": "celery_queue_length", "legendFormat": "waiting {{queue_name}}"}, {"expr": "celery_active_worker_count", "legendFormat": "workers {{queue_name}}"}, {"expr": "sum by (key) (redis_key_size{key=\"celery\"})", "legendFormat": "{{key}} (default, no consumer)"}, {"expr": "redis_key_size{key=\"unacked\"}", "legendFormat": "reserved (delivered, not acknowledged)"}]},
    {"type": "row", "title": "Application diagnostics", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 102}, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Celery active work and latency", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 103}, "targets": [{"expr": "sum by (hostname) (celery_worker_tasks_active)", "legendFormat": "active {{hostname}}"}, {"expr": "histogram_quantile(0.95, sum by (le, task_family, queue) (rate(cinematacms_celery_task_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{task_family}} {{queue}}"}]},
    {"type": "timeseries", "title": "Media profile and workload", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 103}, "targets": [{"expr": "sum by (resolution, codec, extension, outcome, reason_code) (rate(cinematacms_media_encoding_profile_total[$__rate_interval]))", "legendFormat": "{{resolution}} {{codec}} {{extension}} {{outcome}} {{reason_code}}"}, {"expr": "histogram_quantile(0.95, sum by (le, media_type) (rate(cinematacms_encoding_input_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "duration p95 {{media_type}}"}, {"expr": "histogram_quantile(0.95, sum by (le, media_type) (rate(cinematacms_encoding_input_file_size_bytes_bucket[$__rate_interval])))", "legendFormat": "size p95 {{media_type}}"}]},
    {"type": "timeseries", "title": "Email attempts and latency", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 111}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(cinematacms_email_delivery_attempts_bucket[$__rate_interval])))", "legendFormat": "attempts p95"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(cinematacms_email_delivery_latency_seconds_bucket[$__rate_interval])))", "legendFormat": "delivery latency p95"}]},
    {"type": "timeseries", "title": "Scheduled job lifecycle", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 111}, "targets": [{"expr": "time() - cinematacms_scheduled_job_last_started_timestamp_seconds", "legendFormat": "last start {{job}}"}, {"expr": "sum by (job, outcome, reason_code) (rate(cinematacms_scheduled_job_runs_total[$__rate_interval]))", "legendFormat": "{{job}} {{outcome}} {{reason_code}}"}]},
    {"type": "timeseries", "title": "Database query latency", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 119}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le, workload, context_group, operation, outcome, database) (rate(cinematacms_db_query_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "{{workload}} {{context_group}} {{operation}} {{outcome}} {{database}}"}]},
    {"type": "timeseries", "title": "Cache health", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 119}, "targets": [{"expr": "sum by (family, operation, result) (rate(cinematacms_cache_operations_total[$__rate_interval]))", "legendFormat": "ops {{family}} {{operation}} {{result}}"}, {"expr": "histogram_quantile(0.95, sum by (le, family, operation, result) (rate(cinematacms_cache_operation_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95 {{family}} {{operation}} {{result}}"}, {"expr": "sum by (family, result) (cinematacms_cache_items_total) or on() vector(0)", "legendFormat": "items {{family}} {{result}}"}]},
    {"type": "timeseries", "title": "Authentication failures", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 127}, "targets": [{"expr": "sum by (surface, mechanism, reason) (rate(cinematacms_authentication_failures_total[$__rate_interval]))", "legendFormat": "{{surface}} {{mechanism}} {{reason}}"}]},
    {"type": "timeseries", "title": "Telemetry contract health", "datasource": {"uid": "victoriametrics"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 127}, "targets": [{"expr": "sum by (signal, component, stage) (rate(cinematacms_telemetry_emission_failures_total[$__rate_interval])) or on() vector(0)", "legendFormat": "emission {{signal}} {{component}} {{stage}}"}, {"expr": "sum by (component, field) (rate(cinematacms_telemetry_contract_violations_total[$__rate_interval])) or on() vector(0)", "legendFormat": "contract {{component}} {{field}}"}]},
