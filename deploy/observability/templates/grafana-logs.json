    {
      "type": "logs",
      "title": "Correlation lookup",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 82},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "(${filter:raw}) AND (actor_ref:\"$actor_ref\" OR task_id:\"$task_id\" OR delivery_uuid:\"$delivery_uuid\" OR trace_id:\"$trace_id\" OR recipient_ref:\"$recipient_ref\")", "maxLines": 500, "queryType": "instant"}],
      "options": {"showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"}
