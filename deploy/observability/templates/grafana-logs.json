    {
      "type": "stat",
      "title": "Matching logs",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 56},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "${filter:raw} | count()", "queryType": "stats"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Error and critical logs",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 56},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "(${filter:raw}) AND severity_text:~\"ERROR|CRITICAL|FATAL\" | count()", "queryType": "stats"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "type": "timeseries",
      "title": "Log volume by severity",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 56},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "(${filter:raw}) AND severity_text:* | stats by (_time:$__interval, severity_text) count() logs", "legendFormat": "{{severity_text}}", "queryType": "statsRange"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "Log volume by service or unit",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 61},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "${filter:raw} | stats by (_time:$__interval, service_role, systemd.unit) count() logs", "legendFormat": "{{service_role}} {{systemd.unit}}", "queryType": "statsRange"}],
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "bargauge",
      "title": "Top log messages and events",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 64},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "${filter:raw} | stats by (_msg, event, outcome, reason_code) count() logs | sort by (logs desc) | limit 25", "legendFormat": "{{event}} {{_msg}} {{outcome}} {{reason_code}}", "queryType": "stats"}],
      "options": {"displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "minVizWidth": 8, "minVizHeight": 16}
    },
    {
      "type": "logs",
      "title": "Errors and critical logs",
      "datasource": {"type": "victoriametrics-logs-datasource", "uid": "victorialogs"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 72},
      "targets": [{"refId": "A", "editorMode": "code", "expr": "(${filter:raw}) AND severity_text:~\"ERROR|CRITICAL|FATAL\"", "maxLines": 500, "queryType": "instant"}],
      "options": {"showTime": true, "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"}
