[Unit]
Description=Cinemata PostgreSQL exporter
After=network-online.target postgresql.service

[Service]
User=cinematacms-postgres-exporter
Group=cinematacms-postgres-exporter
EnvironmentFile=/etc/cinematacms-observability/postgres-exporter.env
ExecStart=/opt/cinematacms-observability/bin/postgres_exporter --web.listen-address=127.0.0.1:9187
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
