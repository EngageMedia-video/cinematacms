[Unit]
Description=CinemataCMS email delivery worker
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
EnvironmentFile=/etc/cinematacms/app.env
Environment=APP_DIR="/home/cinemata/cinematacms"
Environment=CELERY_QUEUE="email_tasks"
Environment=CELERY_BIN="/home/cinemata/bin/celery"
Environment=CELERY_APP="cms"
Environment=CELERYD_OPTS="--concurrency=4 --prefetch-multiplier=1"
Environment=CELERYD_PID_FILE="/home/cinemata/cinematacms/pids/%n.pid"
Environment=CELERYD_LOG_FILE="/home/cinemata/cinematacms/logs/%N.log"
Environment=CELERYD_LOG_LEVEL="INFO"
Environment=PYTHONPATH="/home/cinemata/cinematacms"
Environment=PROMETHEUS_MULTIPROC_DIR="/tmp/prometheus_multiproc"
Environment=OTEL_SERVICE_ROLE="email"
WorkingDirectory=/home/cinemata/cinematacms
Restart=always
RestartSec=10

ExecStart=/bin/sh -c '${CELERY_BIN} -A ${CELERY_APP} worker -n email@%H --pidfile=${CELERYD_PID_FILE} --logfile=${CELERYD_LOG_FILE} --loglevel=${CELERYD_LOG_LEVEL} ${CELERYD_OPTS} -Q ${CELERY_QUEUE}'
ExecStop=/bin/kill -s TERM $MAINPID
ExecReload=/bin/kill -s HUP $MAINPID

[Install]
WantedBy=multi-user.target
