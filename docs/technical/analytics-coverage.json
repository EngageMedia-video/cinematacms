  "exclusions": [
    {
      "id": "security-forms",
      "reason": "Password, MFA, email verification and sensitive authentication errors are not tracked."
    },
    {
      "id": "staff-operations",
      "reason": "Staff, editors, managers and superusers are excluded. A curator is eligible unless also staff."
    },
    {
      "id": "denied-access",
      "reason": "No configuration or event is emitted before access succeeds."
    },
    {
      "id": "raw-ticks",
      "reason": "Playback/upload ticks, raw volume values and menu open/close are omitted."
    },
    {
      "id": "owner-reports",
      "reason": "Report filters, CSV exports and analytics navigation do not inflate audience figures."
    },
    {
      "id": "tool-preview",
      "reason": "Upload preview/demo playback is not audience viewing."
    },
    {
      "id": "role-session-joins",
      "reason": "Do not join audience roles with Umami sessions or demographics."
    }
  ]
